# Copy this file to ".env" (same folder) and fill in your values.
# ".env" is never committed — keep your passwords out of git.

PORT=5012
FRONTEND_URL=http://localhost:5173

# MySQL (e.g. WampServer / XAMPP / MySQL 8). Create the empty database first:
#   CREATE DATABASE merilone CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
# The backend creates all tables itself on first start.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=merilone

# Any long random text (used to sign logins)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=20
LIBRARY_MAX_FILE_SIZE_MB=50

# Optional — AI features (local Ollama)
OLLAMA_HOST=http://localhost:11434
#OLLAMA_MODEL=

# Optional — payments (B2G portal sign-up only; not needed for the apps)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PLAN_ID=
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_PROXY_URL=

# Optional — sending emails (OPI / letters "Send via email")
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM_NAME=Meril One
